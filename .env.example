# Copy to .env. Every variable is optional: without a speech-to-text service the app runs in
# "no-keys" mode (typed transmissions).
# Keep comments on their own line: Compose reads a trailing "# ..." after an empty value as the value.
# Whisper STT + TTS pilot voice
OPENAI_API_KEY=
# Fallback parser (Claude Haiku)
ANTHROPIC_API_KEY=
POSTGRES_PASSWORD=towerwhisper

# Local dev only (docker compose overrides it to point at the db container)
DATABASE_URL=postgres://towerwhisper:towerwhisper@localhost:5432/towerwhisper

# Comms Watchdog limits in minutes (NO_CONTACT amber / red)
COMMS_CAUTION_MIN=15
COMMS_WARNING_MIN=30

# Host port for the web UI (change it if 8080 is already taken, e.g. by Oracle XE)
WEB_PORT=8080

# Local Whisper on an NVIDIA GPU (Docker Desktop with GPU support). To enable, set both:
#   COMPOSE_PROFILES=whisper            starts the whisper container
#   WHISPER_URL=http://whisper:9000     the api sends PTT audio there (OpenAI is the fallback)
# For "pnpm --filter api start:dev", publish the port and use WHISPER_URL=http://localhost:9000.
COMPOSE_PROFILES=
WHISPER_URL=
# faster-whisper model: large-v3 (best), large-v3-turbo / turbo (faster), medium.en ...
WHISPER_MODEL=large-v3
